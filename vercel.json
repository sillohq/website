{
    "$schema": "https://openapi.vercel.sh/vercel.json",

    "installCommand": "bun install --frozen-lockfile",
    "buildCommand": "bun run build",
    "outputDirectory": "dist",

    "trailingSlash": false,

    "rewrites": [
        {
            "source": "/((?!.*\\.).*)",
            "destination": "/index.html"
        }
    ]
}
